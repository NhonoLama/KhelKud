{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "src/**/*.ts",
    "drizzle.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}